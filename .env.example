# Config for `docker compose up` (repo root). Copy this to `.env` and fill in the real
# values -- `.env` is gitignored, this example file is the only one that's committed.
#
#   cp .env.example .env

# Postgres -- the "telematics_pipeline" database itself is created automatically by the
# POSTGRES_DB var below; the API applies EF Core migrations on its own first startup.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=telematics_pipeline

# .NET API -- signs and validates dashboard login tokens. Generate one with:
#   openssl rand -base64 48
JWT_SIGNING_KEY=replace_with_a_long_random_string
JWT_ISSUER=telematics-api
JWT_AUDIENCE=telematics-dashboard

# AI assistant -- from https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Dashboard -- a free public token from https://www.mapbox.com/
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here
